+// ------------------------------------------------------------------------------------------------------------------
+// Inline dequantization of a quantized K/V cache.
+//
+// Before Ada the MMA kernel cannot read quantized K/V, so launch_fattn converts the whole cache to a
+// F16 scratch buffer on every call. At 54k context that conversion is 67% of the attention time.
+// Instead the quantized rows are DMA'd into a shared staging buffer and expanded into the same F16
+// tile the rest of the kernel already consumes, so nothing downstream of the tile changes.
+//
+// cp.async is a DMA and cannot dequantize, hence the staging buffer: it keeps the multi-stage
+// pipeline intact and puts only the expansion on the critical path.
+
+#define FATTN_MMA_Q_TYPE GGML_TYPE_Q4_0
+
+// Bytes of one quantized row of D values. A q4_0 row of 256 values is 8*18 == 144 B == 9 aligned
+// 16 B chunks, which is what lets cp.async move it unrepacked. That only holds for D % 64 == 0;
+// at D == 128 a row is 72 B and every other row would start misaligned.
+static constexpr __host__ __device__ int fattn_mma_q_row_bytes(const int D) {
+    return (D/QK4_0)*int(sizeof(block_q4_0));
+}
+
+template<int D, int nwarps, int nbatch_fa>
+static __device__ __forceinline__ void flash_attn_ext_f16_load_tile_q(
+        const char * const __restrict__ KV, char * const __restrict__ stage, const int stride_KV_bytes) {
+    constexpr int warp_size   = ggml_cuda_get_physical_warp_size();
+    constexpr int nbytes_row  = fattn_mma_q_row_bytes(D);
+    constexpr int chunks_row  = nbytes_row / 16;
+    constexpr int nchunks     = nbatch_fa * chunks_row;
+    static_assert(nbytes_row % 16 == 0, "quantized row is not a whole number of 16 byte cp.async chunks");
+
+    const unsigned int stage_32 = ggml_cuda_cvta_generic_to_shared(stage);
+
+#pragma unroll
+    for (int c0 = 0; c0 < nchunks; c0 += nwarps*warp_size) {
+        const int c = c0 + threadIdx.y*warp_size + threadIdx.x;
+
+        if (c0 + nwarps*warp_size > nchunks && c >= nchunks) {
+            break;
+        }
+
+        const int i = c / chunks_row;
+        const int k = c % chunks_row;
+
+        cp_async_cg_16<128>(stage_32 + c*16, KV + i*stride_KV_bytes + k*16);
+    }
+}
+
+// Expand the staged q4_0 rows into the F16 tile. Uses the same arithmetic as convert.cu's
+// dequantize_block_q4_0: q - 8 is exact and -8*d is exact, so (q - 8.0f)*d and fmaf(d, q, -8*d) both
+// round the exact product once and give the same float, hence the same half. The tile is therefore
+// bit-identical to what the conversion pass writes today.
+template<int stride_tile, int nwarps, int nbatch_fa, int D>
+static __device__ __forceinline__ void flash_attn_ext_f16_dequant_tile_q(
+        const char * const __restrict__ stage, half2 * const __restrict__ tile_KV) {
+    constexpr int warp_size  = ggml_cuda_get_physical_warp_size();
+    constexpr int nbytes_row = fattn_mma_q_row_bytes(D);
+    constexpr int blocks_row = D / QK4_0;
+    constexpr int nblocks    = nbatch_fa * blocks_row;
+
+#pragma unroll
+    for (int b0 = 0; b0 < nblocks; b0 += nwarps*warp_size) {
+        const int b = b0 + threadIdx.y*warp_size + threadIdx.x;
+
+        if (b0 + nwarps*warp_size > nblocks && b >= nblocks) {
+            break;
+        }
+
+        const int i  = b / blocks_row;
+        const int kb = b % blocks_row;
+
+        const block_q4_0 * blk = (const block_q4_0 *) (stage + i*nbytes_row) + kb;
+        const float d = __half2float(blk->d);
+
+        half2 * dst = (half2 *) ((half *) (tile_KV + i*stride_tile) + kb*QK4_0);
+
+#pragma unroll
+        for (int j = 0; j < QK4_0/2; j += 2) {
+            const int q0 = blk->qs[j + 0];
+            const int q1 = blk->qs[j + 1];
+
+            dst[(j + 0)/2] = __floats2half2_rn((float(q0 & 0x0F) - 8.0f)*d, (float(q1 & 0x0F) - 8.0f)*d);
+            dst[(j + 16)/2] = __floats2half2_rn((float(q0 >>   4) - 8.0f)*d, (float(q1 >>   4) - 8.0f)*d);
+        }
+    }
+}
+
